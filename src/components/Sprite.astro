---
// Gen 2 (Crystal) sprite. Click toggles the shiny palette (see scripts/main.js).
const { id, scale = 3, alt = '', shiny = true } = Astro.props;
---

<img
  class="sprite"
  src={`/sprites/${id}.png`}
  alt={alt}
  width="56"
  height="56"
  loading="lazy"
  decoding="async"
  data-id={id}
  data-shiny={shiny ? '' : null}
  style={`--scale:${scale}`}
/>
